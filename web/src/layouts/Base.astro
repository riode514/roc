---
import '../styles/tokens.css';
import '../styles/cobrand.css';
import '../styles/design-system.css';
import '../styles/page.css';

const {
  title = 'ROC Propietats · Prime residences in Andorra',
  description = 'Exceptional homes across the seven parishes of Andorra, presented with the reach of an international network and the discretion of a private office.',
  lang = 'en',
  image = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ROC Propietats" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href="/fonts/cormorant-garamond.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/inter.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preconnect" href="https://rocpropietats.com" />
  </head>
  <body>
    <div style="background:#FAFAF8;color:var(--roc-ink,#13294B);font-family:'Inter',system-ui,sans-serif;font-size:15px;line-height:1.6;">
      <slot />
    </div>

    <style is:global>
      /* Palette, as the design defines it. "Mid navy & yellow" is the chosen
         one: it keeps the Hamptons navy and brings back the yellow from ROC's
         previous site as the accent. The other two are the design's
         alternatives, kept here so the scheme can be switched in one place.
           Navy            #13294B  #5B6F8F  #C5CFDA
           Graphite & stone #222420 #8A8A7A  #A8A898
         The yellow is only ever used on navy — never as text on cream. */
      :root {
        --roc-ink:     #13294B;
        --roc-accent:  #5B6F8F;
        --roc-accent2: #FFED00;
      }

      /* The design expressed hovers as a `style-hover` attribute; these are the
         same transitions written as real CSS. */
      a { text-decoration: none; color: inherit; }
      img { max-width: 100%; }
      *:focus-visible { outline: 2px solid var(--roc-accent,#8A8A7A); outline-offset: 3px; }

      .roc-btn-light:hover { background: #fff !important; color: var(--roc-ink,#13294B) !important; }
      .roc-btn-solid:hover { background: var(--roc-accent2,#A8A898) !important; color: var(--roc-ink,#13294B) !important; }
      .roc-btn-navy:hover  { background: var(--roc-ink,#13294B) !important; color: #fff !important; }
      .roc-btn-stone:hover { background: var(--roc-accent,#8A8A7A) !important; border-color: var(--roc-accent,#8A8A7A) !important; color: #fff !important; }
      .roc-card { transition: transform .3s ease, box-shadow .3s ease; }
      .roc-card:hover { transform: translateY(-4px); }
      .roc-card:hover .roc-card-img { transform: scale(1.03); }
      .roc-card-img { transition: transform .6s ease; }

      .roc-filter { background: none; border: 0; padding: 0 0 8px; cursor: pointer;
        font-size: 10.5px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase;
        border-bottom: 1px solid transparent; color: #8A877F; transition: all .25s ease; }
      .roc-filter[aria-pressed="true"] { color: var(--roc-ink,#13294B); border-bottom-color: var(--roc-ink,#13294B); }
      .roc-filter:hover { color: var(--roc-ink,#13294B); }

      .roc-parish-row { border-bottom: 1px solid #DDDBD6; padding: 20px 0; cursor: pointer; }
      .roc-parish-row .roc-parish-name { color: #8A877F; transition: color .25s ease; }
      .roc-parish-row[aria-expanded="true"] .roc-parish-name,
      .roc-parish-row:hover .roc-parish-name { color: var(--roc-ink,#13294B); }
      .roc-parish-note { display: none; }
      .roc-parish-row[aria-expanded="true"] .roc-parish-note { display: block; }

      @media (max-width: 760px) {
        section, footer { padding-left: 20px !important; padding-right: 20px !important; }
        header > div, section > div, footer > div { padding-left: 0 !important; padding-right: 0 !important; }
        /* The lock-up is too wide for a phone: drop the "in association with"
           caption and its rule, and let the two marks sit closer together. */
        .roc-logo { gap: 14px !important; flex-wrap: wrap; }
        .roc-logo-assoc, .roc-logo-rule { display: none !important; }
        .roc-logo img { height: 20px !important; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </body>
</html>
