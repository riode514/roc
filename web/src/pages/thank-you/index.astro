---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<Base title="Thank you. · ROC Propietats" lang="en">
  <div style="background:#F5F0EB;">
    <SiteHeader tone="dark" lang="en" />
  </div>
  <section style="padding:140px 40px;min-height:50vh;">
    <div style="max-width:640px;margin:0 auto;text-align:center;">
      <div style="width:40px;height:1px;background:#8A8A7A;margin:0 auto 28px;"></div>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(34px,4vw,52px);margin:0 0 16px;">Thank you.</h1>
      <p style="font-size:16px;line-height:1.75;color:#8A877F;margin:0 0 36px;">A member of our team will be in touch personally within one working day.</p>
      <a href="/" class="roc-btn-navy" style="font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:15px 34px;border:1px solid #13294B;border-radius:2px;transition:all .25s ease;">← Back to home</a>
    </div>
  </section>
  <SiteFooter lang="en" />
</Base>
