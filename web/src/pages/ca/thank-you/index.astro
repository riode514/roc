---
import Base from '../../../layouts/Base.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
---
<Base title="Gràcies. · ROC Propietats" lang="ca">
  <div style="background:#F5F0EB;">
    <SiteHeader tone="dark" lang="ca" />
  </div>
  <section style="padding:140px 40px;min-height:50vh;">
    <div style="max-width:640px;margin:0 auto;text-align:center;">
      <div style="width:40px;height:1px;background:#8A8A7A;margin:0 auto 28px;"></div>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(34px,4vw,52px);margin:0 0 16px;">Gràcies.</h1>
      <p style="font-size:16px;line-height:1.75;color:#8A877F;margin:0 0 36px;">Un membre del nostre equip es posarà en contacte personalment en un dia laborable.</p>
      <a href="/ca/" class="roc-btn-navy" style="font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:15px 34px;border:1px solid #13294B;border-radius:2px;transition:all .25s ease;">← Tornar a l'inici</a>
    </div>
  </section>
  <SiteFooter lang="ca" />
</Base>
