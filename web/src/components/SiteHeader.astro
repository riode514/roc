---
// Header as drawn in the design, in two tones: `light` sits over the hero
// image, `dark` sits on a cream background for interior pages.
const { tone = 'light', lang = 'en', langHref = {} } = Astro.props;

const onImage = tone === 'light';
const ink = onImage ? '#fff' : '#13294B';
const sub = onImage ? 'rgba(255,255,255,.7)' : '#8A8A7A';
const rule = onImage ? 'rgba(255,255,255,.22)' : '#DDDBD6';
const home = lang === 'ca' ? '/ca/' : '/';

const nav = lang === 'ca'
  ? [['Residències', '#residences'], ['Parròquies', '#parishes'], ['Hamptons', '#association'], ['Assessorament', '#services'], ['Contacte', '#contact']]
  : [['Residences', '#residences'], ['Parishes', '#parishes'], ['Hamptons', '#association'], ['Advisory', '#services'], ['Contact', '#contact']];
const cta = lang === 'ca' ? 'Sol·licita una valoració' : 'Request a Valuation';
---
<header style={`position:relative;z-index:2;${onImage ? '' : `border-bottom:1px solid ${rule};`}`}>
  <div style="max-width:1400px;margin:0 auto;padding:28px 40px 0;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:22px 32px;">
    <a href={home} class="roc-logo" style={`display:flex;align-items:center;gap:22px;color:${ink};min-width:0;`}>
      <span style="display:flex;flex-direction:column;gap:6px;">
        <span style={`font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:30px;letter-spacing:.28em;line-height:1;color:${ink};`}>ROC<span style="color:#A8A898;">.</span></span>
        <span style={`font-size:8.5px;font-weight:500;letter-spacing:.42em;text-transform:uppercase;color:${sub};`}>Propietats · Andorra</span>
      </span>
      <span class="roc-logo-rule" style={`width:1px;align-self:stretch;background:${rule};`}></span>
      <span class="roc-logo-assoc" style={`font-size:8.5px;font-weight:500;letter-spacing:.34em;text-transform:uppercase;color:${sub};line-height:1.6;`}>In association<br />with</span>
      <span style="display:flex;flex-direction:column;align-items:center;gap:4px;">
        {onImage
          ? <img src="/brand/hamptons-wordmark.png" alt="Hamptons International" style="height:22px;width:auto;display:block;" />
          : <img src="/brand/hamptons-international.png" alt="Hamptons International" style="height:34px;width:auto;display:block;" />}
        {onImage && <span style="font-size:6.6px;font-weight:600;letter-spacing:.32em;line-height:1;color:#FF5D5C;padding-left:.32em;">INTERNATIONAL</span>}
      </span>
    </a>

    <nav style={`order:3;flex:1 1 100%;display:flex;justify-content:center;gap:12px 40px;padding:16px 0;border-top:1px solid ${rule};border-bottom:1px solid ${rule};flex-wrap:wrap;font-size:10.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;`}>
      {nav.map(([label, href]) => (
        <a href={href.startsWith('#') ? `${home}${href}` : href} style={`color:${ink};`}>{label}</a>
      ))}
    </nav>

    <a href={`${home}#contact`} class={onImage ? 'roc-btn-light' : 'roc-btn-stone'}
       style={onImage
         ? 'font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:13px 26px;border:1px solid rgba(255,255,255,.8);border-radius:2px;color:#fff;transition:all .25s ease;'
         : 'font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:13px 26px;background:#13294B;color:#fff;border:1px solid #13294B;border-radius:2px;transition:all .25s ease;'}>
      {cta}
    </a>
  </div>
</header>
