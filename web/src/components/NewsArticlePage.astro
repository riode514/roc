---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import AgiaBanner from './AgiaBanner.astro';
import { formatDate, newsUrl } from '../lib/content.js';
import { newsPath, t } from '../lib/i18n.js';

const { article, related = [], lang = 'en' } = Astro.props;
const c = t(lang);
const a = article.t(lang);
---
<Base title={`${a.title} · ROC Propietats`} description={a.excerpt ?? a.title}
      lang={lang} image={article.cover_url}>
  <div style="background:#F5F0EB;">
    <SiteHeader tone="dark" lang={lang} />
  </div>

  <section style="background:#F5F0EB;padding:44px 40px 52px;">
    <div style="max-width:820px;margin:0 auto;">
      <a href={newsPath(lang)} style="font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:#8A877F;">{c.backToNews}</a>
      <div style="display:flex;align-items:center;gap:14px;margin:24px 0 14px;flex-wrap:wrap;">
        {a.category && (
          <span style="background:var(--roc-ink,#13294B);color:#fff;font-size:9.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:6px 10px;border-radius:2px;">{a.category}</span>
        )}
        <span style="font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:#8A877F;">
          {c.published} {formatDate(article.published_on, lang)}
        </span>
      </div>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(32px,4vw,54px);line-height:1.08;margin:0;text-wrap:balance;">
        {a.title}
      </h1>
    </div>
  </section>

  {article.cover_url && (
    <section style="background:var(--roc-ink,#13294B);">
      <img src={article.cover_url} alt={a.title ?? ''} fetchpriority="high"
           style="width:100%;max-height:min(62vh,640px);object-fit:cover;display:block;" />
    </section>
  )}

  <section style="padding:72px 40px 96px;">
    <div style="max-width:820px;margin:0 auto;">
      {!a.translated && (
        <p style="font-size:12.5px;color:#8A877F;border-left:2px solid #DDDBD6;padding-left:16px;margin:0 0 32px;">
          {/* ROC has not published this piece in the chosen language. */}
          {c.sourceNote}
        </p>
      )}

      {a.excerpt && !a.body_html && (
        <p style="font-size:17px;line-height:1.8;margin:0 0 28px;">{a.excerpt}</p>
      )}

      {a.body_html && <div class="roc-prose" set:html={a.body_html} />}

      <p style="margin:44px 0 0;font-size:12.5px;">
        <a href={a.source_url} rel="nofollow noopener" target="_blank"
           style="color:#8A877F;border-bottom:1px solid #DDDBD6;padding-bottom:3px;">{c.sourceNote}</a>
      </p>
    </div>
  </section>

  {related.length > 0 && (
    <section style="padding:0 40px 100px;">
      <div style="max-width:1400px;margin:0 auto;">
        <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:32px;margin:0 0 40px;padding-bottom:20px;border-bottom:1px solid #DDDBD6;">{c.relatedNews}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));gap:32px;">
          {related.map((r) => (
            <a class="roc-card" href={newsUrl(r, lang)} style="display:flex;flex-direction:column;background:#fff;border:1px solid #DDDBD6;">
              <div style="position:relative;aspect-ratio:3/2;background:#F0EFEC;overflow:hidden;">
                {r.cover_url && <img class="roc-card-img" src={r.cover_url} alt="" loading="lazy" decoding="async"
                     style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;" />}
              </div>
              <div style="padding:22px 24px 26px;">
                <div style="font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--roc-accent,#8A8A7A);margin-bottom:9px;">
                  {formatDate(r.published_on, lang)}
                </div>
                <h3 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:21px;line-height:1.25;margin:0;">{r.t(lang).title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <AgiaBanner lang={lang} />
  <SiteFooter lang={lang} />
</Base>

<style is:global>
  /* ROC's article bodies are plain prose with links; this is the typography
     for them, matching the design's body scale. The HTML itself was reduced
     to a tag allowlist at ingest. */
  .roc-prose { font-size: 16.5px; line-height: 1.85; color: #3A3B38; }
  .roc-prose p { margin: 0 0 22px; text-wrap: pretty; }
  .roc-prose h2, .roc-prose h3, .roc-prose h4 {
    font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 400;
    color: var(--roc-ink, #13294B); line-height: 1.25; margin: 40px 0 14px; }
  .roc-prose h2 { font-size: 30px; }
  .roc-prose h3 { font-size: 25px; }
  .roc-prose h4 { font-size: 21px; }
  .roc-prose a { color: var(--roc-ink, #13294B); border-bottom: 1px solid #DDDBD6;
    padding-bottom: 1px; transition: border-color .2s ease; }
  .roc-prose a:hover { border-bottom-color: var(--roc-ink, #13294B); }
  .roc-prose ul, .roc-prose ol { margin: 0 0 22px; padding-left: 22px; }
  .roc-prose li { margin-bottom: 8px; }
  .roc-prose strong { font-weight: 600; }
  .roc-prose blockquote { margin: 28px 0; padding-left: 22px;
    border-left: 2px solid var(--roc-accent, #8A8A7A); color: #8A877F; font-style: italic; }
</style>
