---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { localeBase, t } from '../lib/i18n.js';

const { lang = 'en' } = Astro.props;
const c = t(lang);
---
<Base title={`${c.thanksTitle} · ROC Propietats`} lang={lang}>
  <div style="background:#F5F0EB;">
    <SiteHeader tone="dark" lang={lang} />
  </div>
  <section style="padding:140px 40px;min-height:50vh;">
    <div style="max-width:640px;margin:0 auto;text-align:center;">
      <div style="width:40px;height:1px;background:var(--roc-accent,#8A8A7A);margin:0 auto 28px;"></div>
      <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(34px,4vw,52px);margin:0 0 16px;">{c.thanksTitle}</h1>
      <p style="font-size:16px;line-height:1.75;color:#8A877F;margin:0 0 36px;">{c.thanksBody}</p>
      <a href={`${localeBase(lang)}/`} class="roc-btn-navy"
         style="font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:15px 34px;border:1px solid var(--roc-ink,#13294B);border-radius:2px;transition:all .25s ease;">
        {c.thanksBack}
      </a>
    </div>
  </section>
  <SiteFooter lang={lang} />
</Base>
