---
// ROC's membership of the Andorran estate agents' college. The wording is
// their own, taken from their site; the Catalan name of the college is kept
// untranslated in every language, because that is its name.
import { t } from '../lib/i18n.js';

const { lang = 'en' } = Astro.props;
const c = t(lang);
---
<section data-screen-label="AGIA" style="background:#F5F0EB;border-top:1px solid #DDDBD6;border-bottom:1px solid #DDDBD6;">
  <div style="max-width:1400px;margin:0 auto;padding:44px 40px;display:flex;align-items:center;justify-content:center;gap:48px;flex-wrap:wrap;text-align:left;">
    <!-- The supplied logo is a JPEG on white, so it sits on a white card
         rather than directly on the cream. -->
    <div style="background:#fff;border:1px solid #DDDBD6;padding:18px 24px;border-radius:2px;flex:0 0 auto;">
      <img src="/brand/agia.jpg" width="760" height="340" loading="lazy" decoding="async"
           alt="agia · Col·legi Professional d’Agents i Gestors Immobiliaris d’Andorra"
           style="display:block;height:58px;width:auto;" />
    </div>
    <div style="max-width:520px;min-width:0;">
      <div style="width:40px;height:1px;background:var(--roc-accent,#8A8A7A);margin-bottom:18px;"></div>
      <p style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(20px,2vw,27px);line-height:1.25;margin:0 0 10px;text-wrap:balance;">
        {c.agiaTitle}
      </p>
      <p style="font-size:12.5px;letter-spacing:.04em;color:#8A877F;margin:0;">
        {c.agiaSubtitle}
      </p>
    </div>
  </div>
</section>

<style>
  @media (max-width: 760px) {
    section[data-screen-label="AGIA"] > div { gap: 26px; padding: 34px 20px; }
  }
</style>
