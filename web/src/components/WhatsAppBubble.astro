---
// Floating WhatsApp button, on every page. It is a plain link — no script and
// no third-party widget, so nothing is loaded from WhatsApp until it is used.
import { SOCIAL, t } from '../lib/i18n.js';

const { lang = 'en' } = Astro.props;
const c = t(lang);
---
<a class="roc-wa" href={SOCIAL.whatsapp} target="_blank" rel="noopener"
   aria-label={c.whatsapp} title={c.whatsapp}>
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M.06 24l1.69-6.16a11.87 11.87 0 01-1.6-5.95C.16 5.33 5.5 0 12.06 0a11.8 11.8 0 018.4 3.49 11.75 11.75 0 013.48 8.4c0 6.55-5.34 11.89-11.9 11.89a11.9 11.9 0 01-5.69-1.45L.06 24zm6.6-3.8c1.68.99 3.28 1.58 5.4 1.58 5.45 0 9.89-4.43 9.9-9.89a9.88 9.88 0 00-9.89-9.9c-5.46 0-9.9 4.44-9.9 9.9 0 2.22.65 3.88 1.74 5.62l-1 3.65 3.75-.97zm11.39-5.3c-.07-.12-.27-.2-.57-.35-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42z"/>
  </svg>
</a>

<style>
  .roc-wa {
    position: fixed; right: 22px; bottom: 22px; z-index: 60;
    width: 54px; height: 54px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #25D366; color: #fff;
    box-shadow: 0 4px 16px rgba(19, 41, 75, .28);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .roc-wa:hover, .roc-wa:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(19, 41, 75, .34);
  }
  /* Out of the way of the menu panel when it is open. */
  body.roc-menu-open .roc-wa { opacity: 0; pointer-events: none; }

  @media (max-width: 760px) {
    .roc-wa { right: 16px; bottom: 16px; width: 50px; height: 50px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .roc-wa { transition: none; }
  }
</style>
