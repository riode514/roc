---
import { SOCIAL, localeBase, newsPath, pagePath, t } from '../lib/i18n.js';

const { lang = 'en' } = Astro.props;
const c = t(lang);
const base = localeBase(lang);
const home = `${base}/`;
---
<footer data-screen-label="Footer" style="background:var(--roc-ink,#13294B);color:rgba(255,255,255,.7);padding:88px 40px 36px;">
  <div style="max-width:1400px;margin:0 auto;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:48px;padding-bottom:64px;border-bottom:1px solid rgba(255,255,255,.14);">
      <div style="grid-column:span 2;min-width:0;">
        <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:28px;">
          <span style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:32px;letter-spacing:.28em;line-height:1;color:#fff;">ROC<span style="color:var(--roc-accent2,#A8A898);">.</span></span>
          <span style="font-size:8.5px;font-weight:500;letter-spacing:.42em;text-transform:uppercase;color:rgba(255,255,255,.6);">Propietats · Andorra</span>
        </div>
        <div style="width:40px;height:1px;background:var(--roc-accent,#8A8A7A);margin-bottom:24px;"></div>
        <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;">
          <span style="font-size:9px;font-weight:500;letter-spacing:.34em;text-transform:uppercase;color:rgba(255,255,255,.55);">{c.inAssociation}</span>
          <span style="display:flex;flex-direction:column;align-items:center;gap:5px;">
            <img src="/brand/hamptons-wordmark.png" alt="Hamptons International" style="height:26px;width:auto;display:block;" />
            <span style="font-size:7.8px;font-weight:600;letter-spacing:.32em;line-height:1;color:#FF5D5C;padding-left:.32em;">INTERNATIONAL</span>
          </span>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:12px;font-size:13.5px;">
        <div style="font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--roc-accent2,#A8A898);margin-bottom:6px;">{c.footExplore}</div>
        <a href={`${base}/residences/?for=sale`} style="color:rgba(255,255,255,.75);">{c.footSale}</a>
        <a href={`${base}/residences/?for=rent`} style="color:rgba(255,255,255,.75);">{c.footRent}</a>
        <a href={newsPath(lang)} style="color:rgba(255,255,255,.75);">{c.navNews}</a>
        <a href={pagePath('about', lang)} style="color:rgba(255,255,255,.75);">{c.navAbout}</a>
        <a href={`${home}#parishes`} style="color:rgba(255,255,255,.75);">{c.footParishes}</a>
        <a href={`${home}#services`} style="color:rgba(255,255,255,.75);">{c.footAdvisory}</a>
      </div>

      <div style="display:flex;flex-direction:column;gap:12px;font-size:13.5px;">
        <div style="font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--roc-accent2,#A8A898);margin-bottom:6px;">{c.footOffice}</div>
        <span>Ctra. General, AD400 La Massana</span>
        <a href="tel:+376747577" style="color:rgba(255,255,255,.75);">+376 747 577</a>
        <a href="mailto:immo@rocpropietats.com" style="color:rgba(255,255,255,.75);">immo@rocpropietats.com</a>
        <a href={`${home}#contact`} style="color:rgba(255,255,255,.75);">{c.footVisit}</a>
      </div>

      <div style="display:flex;flex-direction:column;gap:12px;font-size:13.5px;">
        <div style="font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--roc-accent2,#A8A898);margin-bottom:6px;">{c.followUs}</div>
        <a href={SOCIAL.instagram} target="_blank" rel="noopener" style="color:rgba(255,255,255,.75);">Instagram</a>
        <a href={SOCIAL.facebook} target="_blank" rel="noopener" style="color:rgba(255,255,255,.75);">Facebook</a>
        <a href={SOCIAL.whatsapp} target="_blank" rel="noopener" style="color:rgba(255,255,255,.75);">WhatsApp</a>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:28px;font-size:11.5px;color:rgba(255,255,255,.5);">
      <span>{c.rights}</span>
      <div style="display:flex;gap:24px;">
        <a href={pagePath('legal', lang)} style="color:rgba(255,255,255,.5);">{c.legal}</a>
        <a href={pagePath('privacy', lang)} style="color:rgba(255,255,255,.5);">{c.privacy}</a>
        <a href={pagePath('cookies', lang)} style="color:rgba(255,255,255,.5);">{c.cookies}</a>
      </div>
    </div>
  </div>
</footer>
