---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import PropertyCard from './PropertyCard.astro';
import {
  descriptionOf, formatArea, formatPrice, formatStats, statusLabel, titleOf, typeOf,
} from '../lib/properties.js';
import { localeBase, t } from '../lib/i18n.js';

const { property, related = [], lang = 'en' } = Astro.props;
const base = localeBase(lang);

const title = titleOf(property, lang);
const description = descriptionOf(property, lang);
const c = t(lang);
const tr = property.t(lang);

const rows = [
  [c.ref, property.reference],
  [c.typeLabel, typeOf(property, lang)],
  [c.parishLabel, [property.sublocation, property.parish].filter(Boolean).join(', ')],
  [c.bedrooms, property.bedrooms],
  [c.bathrooms, property.bathrooms],
  [c.built, property.built_m2 ? `${formatArea(property.built_m2)} m²` : null],
  [c.living, property.living_m2 ? `${formatArea(property.living_m2)} m²` : null],
  [c.plot, property.plot_m2 ? `${formatArea(property.plot_m2)} m²` : null],
  [c.terrace, property.terrace_m2 ? `${formatArea(property.terrace_m2)} m²` : null],
  [c.garage, property.garage == null ? null : (property.garage ? c.yes : c.no)],
].filter(([, v]) => v !== null && v !== undefined && v !== '');

const images = property.images;
const pageTitle = `${title} · ${property.parish ?? 'Andorra'} · ROC Propietats`;
---
<Base title={pageTitle} description={description || title} lang={lang} image={property.cover}>
  <div style="background:#F5F0EB;">
    <SiteHeader tone="dark" lang={lang} />
  </div>

  <!-- TITLE BAR -->
  <section style="background:#F5F0EB;padding:48px 40px 40px;">
    <div style="max-width:1400px;margin:0 auto;display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap;">
      <div style="min-width:0;">
        <a href={`${base}/residences/`} style="font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:#8A877F;">{c.back}</a>
        <div style="display:flex;align-items:center;gap:14px;margin:22px 0 10px;flex-wrap:wrap;">
          <span style="background:var(--roc-ink,#13294B);color:#fff;font-size:9.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:6px 10px;border-radius:2px;">{statusLabel(property, lang)}</span>
          <span style="font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--roc-accent,#8A8A7A);">{property.parish ?? ''}</span>
        </div>
        <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:clamp(34px,4vw,58px);line-height:1.08;margin:0;text-wrap:balance;">{title}</h1>
      </div>
      <div style="text-align:right;">
        <div style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:clamp(28px,3vw,40px);line-height:1;">{formatPrice(property, lang)}</div>
        <div style="font-size:13px;color:#8A877F;margin-top:10px;">{formatStats(property, lang)}</div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  {images.length > 0 && (
    <section style="padding:0;background:var(--roc-ink,#13294B);">
      <div style="position:relative;">
        <img id="roc-hero-img" src={images[0].url} alt={title} fetchpriority="high"
             style="width:100%;max-height:min(78vh,820px);object-fit:cover;display:block;" />
        {images.length > 1 && (
          <div style="position:absolute;bottom:16px;right:16px;background:rgba(19,41,75,.82);color:#fff;font-size:11px;letter-spacing:.14em;padding:8px 14px;border-radius:2px;">
            <span id="roc-img-index">1</span> / {images.length}
          </div>
        )}
      </div>
      {images.length > 1 && (
        <div style="display:flex;gap:8px;overflow-x:auto;padding:12px;background:#0f2240;">
          {images.map((m, i) => (
            <button class="roc-thumb" data-src={m.url} data-i={i + 1}
                    style={`flex:0 0 auto;width:112px;height:76px;border:2px solid ${i === 0 ? '#fff' : 'transparent'};padding:0;cursor:pointer;background:none;`}>
              <img src={m.url} alt="" loading="lazy" decoding="async"
                   style="width:100%;height:100%;object-fit:cover;display:block;" />
            </button>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- VIDEO / 360 -->
  {(property.videos.length > 0 || property.tours.length > 0) && (
    <section style="padding:56px 40px 0;">
      <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px;">
        {[...property.tours, ...property.videos].map((m) => (
          <div>
            <div style="font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:#8A877F;margin-bottom:14px;">
              {m.kind === 'tour360' ? c.tour : c.video}
            </div>
            <div style="position:relative;aspect-ratio:16/9;background:#F0EFEC;border:1px solid #DDDBD6;">
              <!-- Matterport and YouTube both check the referrer before allowing
                   an embed, so this deliberately does not send `no-referrer`. -->
              <iframe src={m.url} title={m.kind === 'tour360' ? c.tour : c.video} loading="lazy"
                      allowfullscreen allow="xr-spatial-tracking; fullscreen; accelerometer; gyroscope"
                      style="position:absolute;inset:0;width:100%;height:100%;border:0;"></iframe>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- BODY -->
  <section style="padding:72px 40px 100px;">
    <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:72px;align-items:start;">
      <div>
        {description && (
          <>
            <div style="width:40px;height:1px;background:var(--roc-accent,#8A8A7A);margin-bottom:24px;"></div>
            <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:32px;margin:0 0 20px;">{c.description}</h2>
            <p style="font-size:16px;line-height:1.8;color:#3A3B38;margin:0 0 32px;text-wrap:pretty;white-space:pre-line;">{description}</p>
          </>
        )}

        {tr.features?.length > 0 && (
          <>
            <h3 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:400;font-size:24px;margin:32px 0 16px;">{c.features}</h3>
            <ul style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px 24px;list-style:none;padding:0;margin:0;font-size:14.5px;color:#3A3B38;">
              {tr.features.map((f) => <li style="padding:6px 0;border-bottom:1px solid #DDDBD6;">{f}</li>)}
            </ul>
          </>
        )}

        <p style="margin:40px 0 0;font-size:12.5px;">
          <a href={tr.source_url} rel="nofollow noopener" target="_blank" style="color:#8A877F;border-bottom:1px solid #DDDBD6;padding-bottom:3px;">{c.sourced}</a>
        </p>
      </div>

      <aside>
        <div style="border:1px solid #DDDBD6;background:#fff;padding:36px 32px;">
          <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:28px;margin:0 0 24px;">{c.details}</h2>
          <dl style="margin:0;display:grid;grid-template-columns:1fr auto;gap:0;">
            {rows.map(([label, value]) => (
              <>
                <dt style="font-size:13px;color:#8A877F;padding:13px 0;border-bottom:1px solid #DDDBD6;">{label}</dt>
                <dd style="font-size:14px;margin:0;padding:13px 0;border-bottom:1px solid #DDDBD6;text-align:right;color:var(--roc-ink,#13294B);">{value}</dd>
              </>
            ))}
          </dl>

          <a href={`${base}/#contact`} class="roc-btn-stone"
             style="display:block;text-align:center;margin-top:32px;border:1px solid var(--roc-ink,#13294B);background:var(--roc-ink,#13294B);color:#fff;font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:16px 24px;border-radius:2px;transition:all .25s ease;">
            {c.enquire}
          </a>
          <a href="tel:+376747577" class="roc-btn-navy"
             style="display:block;text-align:center;margin-top:12px;border:1px solid var(--roc-ink,#13294B);color:var(--roc-ink,#13294B);font-size:10.5px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;padding:16px 24px;border-radius:2px;transition:all .25s ease;">
            {c.arrange}
          </a>
        </div>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section style="padding:0 40px 120px;">
      <div style="max-width:1400px;margin:0 auto;">
        <h2 style="font-family:'Cormorant Garamond',Georgia,serif;font-weight:300;font-size:32px;margin:0 0 40px;padding-bottom:20px;border-bottom:1px solid #DDDBD6;">{c.related}</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,360px),1fr));gap:32px;">
          {related.map((p) => <PropertyCard property={p} lang={lang} />)}
        </div>
      </div>
    </section>
  )}

  <SiteFooter lang={lang} />

  <script>
    const hero = document.getElementById('roc-hero-img');
    const idx  = document.getElementById('roc-img-index');
    document.querySelectorAll('.roc-thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (hero) hero.src = btn.dataset.src;
        if (idx)  idx.textContent = btn.dataset.i;
        document.querySelectorAll('.roc-thumb').forEach((b) => {
          b.style.borderColor = b === btn ? '#fff' : 'transparent';
        });
      });
    });
  </script>
</Base>
